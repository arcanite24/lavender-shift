<!-- Pinyon Shift's launcher layout (launcher/PinyonShift.Launcher/MainWindow.xaml
     there), with Lavender's mark and colours and only the parts Lavender uses. -->
<Window x:Class="LavenderShift.Launcher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Lavender Shift" Width="1120" Height="720" MinWidth="940" MinHeight="640"
        WindowStartupLocation="CenterScreen" Background="{StaticResource InkBrush}"
        Foreground="{StaticResource FogBrush}" Icon="Branding/lavender-shift.ico"
        WindowStyle="SingleBorderWindow" ResizeMode="CanResize" AllowDrop="True"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display"
        DragOver="Window_DragOver" Drop="Window_Drop">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="52" ResizeBorderThickness="6" GlassFrameThickness="0"
                      CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Border x:Name="RootBorder" BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="52"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="44"/>
            </Grid.RowDefinitions>

            <!-- Art behind the title bar and the body; the ridges are the horizon. -->
            <Grid Grid.RowSpan="2" ClipToBounds="True">
                <Border Background="{StaticResource HeroGradient}"/>
                <!-- In a zero-size canvas, so the art never sizes the rows it spans. -->
                <Canvas HorizontalAlignment="Right" VerticalAlignment="Top" Width="0" Height="0">
                    <Path Data="{StaticResource MarkGeometry}" Fill="{StaticResource FogBrush}" Opacity="0.05"
                          Height="420" Width="400" Stretch="Uniform" Canvas.Left="-450" Canvas.Top="10"/>
                </Canvas>
                <Path VerticalAlignment="Bottom" Height="170" Stretch="Fill" Opacity="0.55"
                      Data="M0,150 L0,96 L70,62 L120,84 L190,40 L260,78 L330,52 L400,86 L470,48 L560,82 L630,58 L720,90 L800,50 L880,80 L960,44 L1040,76 L1120,54 L1180,70 L1180,150 Z">
                    <Path.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#33255A" Offset="0"/>
                            <GradientStop Color="#0E0B12" Offset="1"/>
                        </LinearGradientBrush>
                    </Path.Fill>
                </Path>
                <Path VerticalAlignment="Bottom" Height="100" Stretch="Fill" Opacity="0.9"
                      Data="M0,92 L0,64 L40,44 L60,56 L90,30 L120,52 L170,38 L230,60 L290,34 L340,56 L400,42 L470,66 L540,36 L600,58 L660,44 L740,64 L820,32 L880,54 L950,40 L1020,62 L1090,38 L1140,52 L1180,44 L1180,92 Z">
                    <Path.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#22183B" Offset="0"/>
                            <GradientStop Color="#0E0B12" Offset="1"/>
                        </LinearGradientBrush>
                    </Path.Fill>
                </Path>
            </Grid>

            <!-- Title bar. -->
            <DockPanel Grid.Row="0" LastChildFill="False">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Margin="28,0,0,0" VerticalAlignment="Center">
                    <Path Data="{StaticResource MarkGeometry}" Fill="{StaticResource FogBrush}" Height="24" Width="23"
                          Stretch="Uniform" VerticalAlignment="Center"/>
                    <TextBlock Text="LAVENDER SHIFT" FontFamily="Bahnschrift SemiBold" FontSize="14.5"
                               VerticalAlignment="Center" Margin="5,1,0,0"/>
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top"
                            WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Style="{StaticResource CaptionButton}" Click="MinimizeButton_Click"
                            AutomationProperties.Name="Minimize">
                        <Path Data="M0,0.5 L10,0.5" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1" SnapsToDevicePixels="True"/>
                    </Button>
                    <Button x:Name="MaximizeButton" Style="{StaticResource CaptionButton}"
                            Click="MaximizeButton_Click" AutomationProperties.Name="Maximize">
                        <Path x:Name="MaximizeGlyph" Data="M0.5,0.5 H9.5 V9.5 H0.5 Z"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1" SnapsToDevicePixels="True"/>
                    </Button>
                    <Button Style="{StaticResource CloseCaptionButton}" Click="CloseButton_Click"
                            AutomationProperties.Name="Close">
                        <Path Data="M0,0 L10,10 M10,0 L0,10"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.1"/>
                    </Button>
                </StackPanel>
            </DockPanel>

            <!-- Body: the state in one headline, one line of detail, the action,
                 and a panel when there is something to do here. -->
            <ScrollViewer x:Name="BodyScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled" Focusable="False">
            <Grid MinHeight="{Binding ViewportHeight, ElementName=BodyScroll}">
            <StackPanel VerticalAlignment="Center" Margin="56,0,56,36">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock x:Name="HeadlineText" Text="Set up Lavender Shift"
                           FontFamily="Bahnschrift SemiBold" FontSize="44"
                           AutomationProperties.LiveSetting="Polite"/>
                <TextBlock Grid.Row="1" x:Name="SubheadText" MaxWidth="640" HorizontalAlignment="Left"
                           TextWrapping="Wrap" LineHeight="22" FontSize="15" Foreground="{StaticResource MutedBrush}"
                           Margin="0,8,0,0" Text="Built on this PC from your own disc and title update. Nothing is uploaded."/>
                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,28,0,0">
                    <Button x:Name="PrimaryButton" Style="{StaticResource PrimaryButton}" MinWidth="200"
                            IsEnabled="False" Click="PrimaryButton_Click">
                        <StackPanel Orientation="Horizontal">
                            <Path x:Name="PrimaryIcon" Data="M0,0 L0,14 L11,7 Z" Fill="{StaticResource InkBrush}"
                                  VerticalAlignment="Center" Margin="0,0,12,0" Visibility="Collapsed"/>
                            <TextBlock x:Name="PrimaryButtonText" Text="Set up"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                       FontFamily="Bahnschrift SemiBold" FontSize="17" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="RepairButton" Content="Run setup again" Style="{StaticResource QuietButton}"
                            Height="54" Padding="24,0" Margin="12,0,0,0" Visibility="Collapsed"
                            Click="RepairButton_Click"
                            AutomationProperties.HelpText="Check the tools, rebuild what changed and prepare the graphics pipelines again."/>
                    <Button x:Name="ChangeFilesButton" Content="Change files" Style="{StaticResource QuietButton}"
                            Height="54" Padding="24,0" Margin="12,0,0,0" Visibility="Collapsed"
                            Click="ChangeFilesButton_Click"
                            AutomationProperties.HelpText="Choose another disc image or title update."/>
                </StackPanel>

                <!-- Setup steps, while there is setup left to do. -->
                <ItemsControl Grid.Row="3" x:Name="RouteList" Margin="0,30,0,0" Focusable="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Rows="1"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,14,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Border Height="3" CornerRadius="1.5" Background="{Binding Brush}"/>
                                <TextBlock Grid.Row="1" Text="{Binding Title}" FontSize="13"
                                           Foreground="{StaticResource MutedBrush}" Margin="0,9,0,0"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>

            <StackPanel Margin="0,32,0,0">
                <!-- What stopped the last setup. -->
                <Border x:Name="FailurePanel" Background="#1D1218" BorderBrush="{StaticResource RedBrush}"
                        BorderThickness="1" CornerRadius="14" Visibility="Collapsed" Margin="0,0,0,16"
                        AutomationProperties.Name="Setup failed">
                    <StackPanel Margin="26,20">
                        <TextBlock x:Name="FailureText" Foreground="#EAD3D8" TextWrapping="Wrap" LineHeight="21" FontSize="14"/>
                        <TextBlock x:Name="FailureExcerpt" Margin="0,10,0,0" FontFamily="Cascadia Mono, Consolas" FontSize="12"
                                   TextWrapping="Wrap" Foreground="#C8B3BA"/>
                        <TextBlock x:Name="FailureHint" Margin="0,10,0,0" FontSize="13" TextWrapping="Wrap"
                                   Foreground="{StaticResource FogBrush}"/>
                    </StackPanel>
                </Border>

                <!-- Setup: the disc image and the title update. -->
                <Border x:Name="SetupPanel" CornerRadius="14" Padding="26,22" VerticalAlignment="Top"
                        Background="{StaticResource SurfaceBrush}">
                    <Grid>
                        <Rectangle RadiusX="14" RadiusY="14" Margin="-26,-22"
                                   Stroke="{StaticResource LineStrongBrush}" StrokeThickness="1.5"
                                   StrokeDashArray="5 4" IsHitTestVisible="False"/>
                        <StackPanel>
                            <DockPanel>
                                <Button DockPanel.Dock="Right" x:Name="BrowseDiscButton" Content="Choose ISO"
                                        Style="{StaticResource QuietButton}" VerticalAlignment="Center" MinWidth="132"
                                        Click="BrowseDisc_Click"/>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock x:Name="DiscTitleText" Text="Drop your Forza Horizon 2 disc image"
                                               FontSize="17" FontFamily="Bahnschrift SemiBold" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock x:Name="DiscDetailText" Text="The USA disc, dumped from your own copy."
                                               FontSize="13" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0"
                                               TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </DockPanel>
                            <DockPanel Margin="0,16,0,0">
                                <Button DockPanel.Dock="Right" x:Name="BrowseUpdateButton" Content="Choose update"
                                        Style="{StaticResource QuietButton}" VerticalAlignment="Center" MinWidth="132"
                                        Click="BrowseUpdate_Click"/>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock x:Name="UpdateTitleText" Text="And the title update v2"
                                               FontSize="17" FontFamily="Bahnschrift SemiBold" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock x:Name="UpdateDetailText" Text="The update package from your console, or a ZIP holding it."
                                               FontSize="13" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0"
                                               TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </DockPanel>
                            <CheckBox x:Name="OwnershipCheckBox" Margin="0,20,0,0"
                                      FontFamily="Bahnschrift" FontSize="13" Checked="InputChanged" Unchecked="InputChanged">
                                <TextBlock Text="I own this game and dumped these files from my own disc and console." TextWrapping="Wrap"
                                           Foreground="{StaticResource FogBrush}"/>
                            </CheckBox>
                            <!-- Microsoft's C++ libraries without the Build Tools install (Pinyon's TP-4). -->
                            <CheckBox x:Name="MicrosoftLicenseCheckBox" Margin="0,10,0,0"
                                      FontFamily="Bahnschrift" FontSize="13" Visibility="Collapsed"
                                      AutomationProperties.Name="Accept Microsoft's license for the C++ libraries">
                                <TextBlock TextWrapping="Wrap" Foreground="{StaticResource FogBrush}">
                                    <Run Text="I accept the "/><Hyperlink Click="MicrosoftLicenseLink_Click"
                                        Foreground="{StaticResource FogBrush}">Microsoft license terms</Hyperlink><Run
                                        Text=" for the C++ libraries and Windows SDK setup downloads. Faster, no administrator prompt; unticked, setup installs the Visual Studio Build Tools instead."/>
                                </TextBlock>
                            </CheckBox>
                            <TextBlock Margin="0,18,0,0" FontSize="12.5" Foreground="{StaticResource MutedBrush}"
                                       TextTrimming="CharacterEllipsis">
                                <Run Text="Builds in "/><Run x:Name="BuildLocationRun" Foreground="{StaticResource FogBrush}"/><Run
                                    x:Name="BuildLocationNoteRun" Text=" · needs 20 GB free"/>
                            </TextBlock>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Android: the package built from this PC's build, and its install. -->
                <Border x:Name="AndroidPanel" CornerRadius="14" Padding="26,22" VerticalAlignment="Top"
                        Background="{StaticResource SurfaceBrush}" Visibility="Collapsed" Margin="0,0,0,16"
                        AutomationProperties.Name="Android">
                    <StackPanel>
                        <TextBlock Text="Android package" FontSize="17" FontFamily="Bahnschrift SemiBold"/>
                        <TextBlock x:Name="AndroidApkText" FontSize="13" Foreground="{StaticResource MutedBrush}"
                                   Margin="0,6,0,0" TextWrapping="Wrap" LineHeight="20"/>
                        <WrapPanel Margin="0,18,0,0">
                            <Button x:Name="AndroidBuildButton" Content="Build APK" Style="{StaticResource QuietButton}"
                                    MinWidth="132" Margin="0,0,10,10" Click="AndroidBuild_Click"
                                    AutomationProperties.HelpText="Compile the game for Android from this PC's build."/>
                            <Button x:Name="AndroidShareButton" Content="Share on Wi-Fi" Style="{StaticResource QuietButton}"
                                    MinWidth="132" Margin="0,0,10,10" Click="AndroidShare_Click"
                                    AutomationProperties.HelpText="Serve the package and the game files to a device on this network."/>
                            <Button x:Name="AndroidUsbButton" Content="Install over USB" Style="{StaticResource QuietButton}"
                                    MinWidth="132" Margin="0,0,10,10" Visibility="Collapsed" Click="AndroidUsb_Click"/>
                            <Button x:Name="AndroidSaveButton" Content="Save a copy" Style="{StaticResource QuietButton}"
                                    MinWidth="132" Margin="0,0,10,10" Click="AndroidSave_Click"
                                    AutomationProperties.HelpText="Save the package to copy it to the device yourself."/>
                            <Button x:Name="AndroidBackButton" Content="Back" Style="{StaticResource LinkButton}"
                                    Margin="0,0,0,10" Click="AndroidBack_Click"/>
                        </WrapPanel>
                        <StackPanel x:Name="AndroidSharePanel" Orientation="Horizontal" Margin="0,8,0,0" Visibility="Collapsed">
                            <Border Background="White" CornerRadius="10" Padding="10" VerticalAlignment="Top">
                                <Image x:Name="AndroidQrImage" Width="176" Height="176"
                                       RenderOptions.BitmapScalingMode="NearestNeighbor"
                                       AutomationProperties.Name="QR code for the device"/>
                            </Border>
                            <StackPanel Margin="20,0,0,0" MaxWidth="420" VerticalAlignment="Center">
                                <TextBlock Text="Pairing code" FontSize="13" Foreground="{StaticResource MutedBrush}"/>
                                <TextBlock x:Name="AndroidCodeText" FontSize="34" FontFamily="Bahnschrift SemiBold"
                                           Margin="0,2,0,8"/>
                                <TextBlock x:Name="AndroidUrlText" FontSize="13" TextWrapping="Wrap" LineHeight="20"
                                           Foreground="{StaticResource FogBrush}"/>
                            </StackPanel>
                        </StackPanel>
                        <TextBlock x:Name="AndroidStatusText" FontSize="13" Margin="0,8,0,0" TextWrapping="Wrap"
                                   LineHeight="20" Foreground="{StaticResource FogBrush}"
                                   AutomationProperties.LiveSetting="Polite"/>
                    </StackPanel>
                </Border>

                <!-- Progress and the build log. -->
                <Border x:Name="LogPanel" Background="{StaticResource SurfaceBrush}" CornerRadius="14" Visibility="Collapsed">
                    <Grid Margin="24,18,24,16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" x:Name="ProgressText" Text="0%" FontSize="13"
                                       FontFamily="Bahnschrift SemiBold" Foreground="{StaticResource AccentBrush}"/>
                            <TextBlock x:Name="ProgressMessageText" FontSize="13"
                                       TextTrimming="CharacterEllipsis" Margin="0,0,16,0"/>
                        </DockPanel>
                        <ProgressBar Grid.Row="1" x:Name="BuildProgress" Minimum="0" Maximum="100" Value="0"
                                     Margin="0,12,0,0"/>
                        <Button Grid.Row="2" x:Name="LogToggleButton" Content="Hide details" HorizontalAlignment="Left"
                                Style="{StaticResource LinkButton}" Margin="-8,10,0,0" Click="LogToggleButton_Click"/>
                        <Border Grid.Row="3" x:Name="LogBox" Background="#0F0C14" CornerRadius="10" Margin="0,4,0,0"
                                Height="190">
                            <TextBox x:Name="LogTextBox" BorderThickness="0" Background="Transparent"
                                     FontSize="11.5" IsReadOnly="True" TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto" Padding="14,10"
                                     AutomationProperties.Name="Setup log"/>
                        </Border>
                    </Grid>
                </Border>
            </StackPanel>
            </StackPanel>
            </Grid>
            </ScrollViewer>

            <!-- Footer. -->
            <DockPanel Grid.Row="2" Margin="46,0,46,0" LastChildFill="False">
                <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center" FontSize="12"
                           Foreground="{StaticResource FaintBrush}">
                    <Run x:Name="VersionRun" Text="Lavender Shift"/><Run Text=" · Not affiliated with Microsoft or Playground Games"/>
                </TextBlock>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="OpenAndroidButton" Content="Android" Style="{StaticResource LinkButton}"
                            Visibility="Collapsed" Click="OpenAndroid_Click"
                            AutomationProperties.HelpText="Build the game for an Android device and install it there."/>
                    <Button x:Name="OpenSavesButton" Content="Saves" Style="{StaticResource LinkButton}"
                            Click="OpenSaves_Click" AutomationProperties.HelpText="Open the folder with your saves and settings."/>
                    <Button x:Name="OpenLogsButton" Content="Logs" Style="{StaticResource LinkButton}"
                            Click="OpenLogs_Click" AutomationProperties.HelpText="Open the setup and game logs."/>
                </StackPanel>
            </DockPanel>

            <!-- Shown while a file is dragged over the window. -->
            <Border x:Name="DropOverlay" Grid.RowSpan="3" Background="#E60E0B12" Visibility="Collapsed"
                    IsHitTestVisible="False">
                <Border BorderBrush="{StaticResource AccentBrush}" BorderThickness="2" CornerRadius="18" Margin="40">
                    <TextBlock x:Name="DropOverlayText" Text="Drop to use this file" FontSize="26" FontFamily="Bahnschrift SemiBold"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
            </Border>
        </Grid>
    </Border>
</Window>
