<!-- The Lavender Shift mark: a lavender sprig whose blossom carries a gear
     knob and a road that winds out of it, after Pinyon Shift's pine. Vector,
     so the title bar, the background art and the icon (tools/render-brand.ps1)
     all draw from this one geometry. Box: 400 x 420. Shapes are joined with
     CombinedGeometry unions, not one group, so opposite windings never cancel. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <CombinedGeometry x:Key="MarkGeometry" GeometryCombineMode="Exclude">
        <CombinedGeometry.Geometry1>
            <CombinedGeometry GeometryCombineMode="Union">
                <CombinedGeometry.Geometry1>
                    <!-- Blossom: whorls of buds, widest low on the spike. -->
                    <GeometryGroup FillRule="Nonzero">
                        <EllipseGeometry Center="200,34" RadiusX="16" RadiusY="30"/>
                        <EllipseGeometry Center="182,70" RadiusX="20" RadiusY="24"/>
                        <EllipseGeometry Center="218,70" RadiusX="20" RadiusY="24"/>
                        <EllipseGeometry Center="200,84" RadiusX="18" RadiusY="24"/>
                        <EllipseGeometry Center="176,108" RadiusX="24" RadiusY="26"/>
                        <EllipseGeometry Center="224,108" RadiusX="24" RadiusY="26"/>
                        <EllipseGeometry Center="200,124" RadiusX="22" RadiusY="26"/>
                        <EllipseGeometry Center="170,148" RadiusX="28" RadiusY="28"/>
                        <EllipseGeometry Center="230,148" RadiusX="28" RadiusY="28"/>
                        <EllipseGeometry Center="200,166" RadiusX="26" RadiusY="28"/>
                        <EllipseGeometry Center="164,190" RadiusX="32" RadiusY="30"/>
                        <EllipseGeometry Center="236,190" RadiusX="32" RadiusY="30"/>
                        <EllipseGeometry Center="200,210" RadiusX="30" RadiusY="30"/>
                        <EllipseGeometry Center="158,234" RadiusX="34" RadiusY="30"/>
                        <EllipseGeometry Center="242,234" RadiusX="34" RadiusY="30"/>
                        <EllipseGeometry Center="200,252" RadiusX="32" RadiusY="30"/>
                        <EllipseGeometry Center="162,274" RadiusX="30" RadiusY="26"/>
                        <EllipseGeometry Center="238,274" RadiusX="30" RadiusY="26"/>
                        <EllipseGeometry Center="200,290" RadiusX="28" RadiusY="24"/>
                    </GeometryGroup>
                </CombinedGeometry.Geometry1>
                <CombinedGeometry.Geometry2>
                    <CombinedGeometry GeometryCombineMode="Union">
                        <CombinedGeometry.Geometry1>
                            <!-- Stem. -->
                            <PathGeometry Figures="M195,300 L205,300 L212,420 L188,420 Z"/>
                        </CombinedGeometry.Geometry1>
                        <CombinedGeometry.Geometry2>
                            <CombinedGeometry GeometryCombineMode="Union">
                                <!-- Two long, narrow leaves from the base. -->
                                <CombinedGeometry.Geometry1>
                                    <PathGeometry Figures="M197,414 C182,378 150,346 104,326 C152,330 188,356 205,394 Z"/>
                                </CombinedGeometry.Geometry1>
                                <CombinedGeometry.Geometry2>
                                    <PathGeometry Figures="M203,414 C218,378 250,346 296,326 C248,330 212,356 195,394 Z"/>
                                </CombinedGeometry.Geometry2>
                            </CombinedGeometry>
                        </CombinedGeometry.Geometry2>
                    </CombinedGeometry>
                </CombinedGeometry.Geometry2>
            </CombinedGeometry>
        </CombinedGeometry.Geometry1>
        <CombinedGeometry.Geometry2>
            <!-- Gear knob, lever and the road out of the blossom: one outline. -->
            <PathGeometry Figures="M194,137 A18,18 0 1 1 206,137 L206,188 C206,200 234,204 234,228 C234,256 204,274 194,294 L186,318 L144,318 L170,276 C182,256 214,246 214,228 C214,212 194,206 194,188 Z"/>
        </CombinedGeometry.Geometry2>
    </CombinedGeometry>
</ResourceDictionary>
