<?xml version="1.0" encoding="utf-8"?>
<!--
  Lavender Shift for Android (docs/ANDROID.md). The package is built on the
  player's PC from their own disc by tools/lavender_android.py and installed
  on their own device; it is never published. The version attributes, the
  minimum and target SDK and the package name are set when the package is
  linked.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    android:installLocation="auto">

    <!-- The renderer is Vulkan only; 1.3-class drivers are the floor. -->
    <uses-feature
        android:name="android.hardware.vulkan.version"
        android:version="0x403000"
        android:required="true" />

    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.gamepad"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.bluetooth"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.usb.host"
        android:required="false" />

    <!-- Rumble on the device itself (SDL's haptics). -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- The title opens system-link sockets at its menus, as it does on
         Windows; without this permission socket() fails. Nothing contacts a
         server. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- The setup screen copies the game files from the player's PC on the
         local network (SetupActivity), over plain HTTP to the launcher: the
         PC has no certificate a phone would trust, and a pairing code guards
         the transfer. -->

    <!-- When the PC's share offers a newer build of this app, the setup
         screen hands it to the system installer (PackageInstaller), which
         asks the player to confirm. Android also asks once to allow this app
         to install apps. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application
        android:label="Lavender Shift"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:hasCode="true"
        android:extractNativeLibs="true"
        android:isGame="true"
        android:appCategory="game"
        android:largeHeap="true"
        android:hardwareAccelerated="true"
        android:usesCleartextTraffic="true"
        android:enableOnBackInvokedCallback="false">

        <!-- simpleperf from adb on a release build: profiling only, no
             debugger. -->
        <profileable android:shell="true" />

        <!-- The title's 16:9 at any width; letterboxed by the presenter. -->
        <meta-data android:name="android.max_aspect" android:value="3.0" />
        <!-- PERFORMANCE and BATTERY game modes (res/xml/game_mode_config.xml). -->
        <meta-data android:name="android.game_mode_config"
            android:resource="@xml/game_mode_config" />

        <!-- The app icon: starts the game, or gets its files from the PC
             first (SetupActivity). -->
        <activity
            android:name="studio.deimos.lavendershift.SetupActivity"
            android:label="Lavender Shift"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar"
            android:configChanges="orientation|screenSize|screenLayout|keyboard|keyboardHidden|navigation|uiMode"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="studio.deimos.lavendershift.SETUP" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <meta-data android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <!-- The game, started by SetupActivity once the game files are in
             place, or directly by tooling (adb shell am start -n). -->
        <activity
            android:name="studio.deimos.lavendershift.LavenderShiftActivity"
            android:label="Lavender Shift"
            android:theme="@android:style/Theme.NoTitleBar.Fullscreen"
            android:screenOrientation="sensorLandscape"
            android:resizeableActivity="false"
            android:alwaysRetainTaskState="true"
            android:launchMode="singleInstance"
            android:configChanges="layoutDirection|locale|grammaticalGender|fontScale|fontWeightAdjustment|orientation|uiMode|screenLayout|screenSize|smallestScreenSize|keyboard|keyboardHidden|navigation"
            android:preferMinimalPostProcessing="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED" />
            </intent-filter>
        </activity>
    </application>

</manifest>
