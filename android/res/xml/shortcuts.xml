<?xml version="1.0" encoding="utf-8"?>
<!-- Long-press the app icon: the setup screen with the game installed, to
     copy DLC, the free-roam pipelines, a save or settings from the PC. -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="setup"
        android:enabled="true"
        android:icon="@mipmap/ic_launcher"
        android:shortcutShortLabel="@string/shortcut_setup_short"
        android:shortcutLongLabel="@string/shortcut_setup_long">
        <intent
            android:action="studio.deimos.lavendershift.SETUP"
            android:targetPackage="studio.deimos.lavendershift"
            android:targetClass="studio.deimos.lavendershift.SetupActivity" />
    </shortcut>
</shortcuts>
